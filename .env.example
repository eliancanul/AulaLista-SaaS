# Sólo referencia: el servidor lee el entorno; no carga este archivo.
AULALISTA_DOCS_ENABLED=false
# Exclusivamente para PostgreSQL desechable; crear rol/grants después de migrar.
# Ver docs/development.md. Nunca arrancar la app con el rol dueño de migraciones.
AULALISTA_DATABASE_URL=postgresql+psycopg://aulalista_runtime@127.0.0.1:55432/aulalista_test
# Deadline HTTP completo y timeout de conexión/consulta, en segundos (2..30).
AULALISTA_DB_TIMEOUT_SECONDS=3

# Optional preparatory authentication. Leave unset to keep normal runtime closed.
# AULALISTA_AUTH_ORIGIN=https://localhost:5173
# AULALISTA_AUTH_HMAC_KEY=<base64url-key-from-authorized-secure-setup>
# AULALISTA_GOOGLE_CLIENT_ID=<authorized-web-client-id>.apps.googleusercontent.com
# No runtime email sender is configured or selectable in this increment.

# Copia este archivo a .env.local para probar localmente sin configurar Google OAuth:
#   cp .env.local.example .env.local
#   bash scripts/dev-local.sh

# --- OpenAI (generación real de anexos) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-6-luna

# --- SMTP para Epson Email Print (ejemplo con Gmail + App Password) ---
# Crea una Contraseña de aplicación en https://myaccount.google.com/apppasswords
# y agrega este correo a la Lista de remitentes aprobados en Epson Connect.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
PRINT_FROM_EMAIL=tu-correo@gmail.com

# --- Opcional: puerto local e intervalo del despachador de trabajos programados ---
PORT=8010
AULALISTA_PRINT_POLLER_SECONDS=15
